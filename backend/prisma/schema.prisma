// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  matricule String    @unique
  firstName String
  lastName  String
  password  String
  role      UserRole
  managerId Int?
  manager   User?     @relation(name: "manager", fields: [managerId], references: [id])
  employees User[]    @relation(name: "manager")
  commands  Command[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([managerId])
}

model Command {
  id           Int           @id @default(autoincrement())
  reference    String        @unique
  status       CommandStatus
  commandDate  DateTime      @default(now())
  deliveryDate DateTime?
  clientId     Int
  client       Client        @relation(fields: [clientId], references: [id])
  truckId      Int?
  truck        Truck?        @relation(fields: [truckId], references: [id])
  userId       Int
  user         User          @relation(fields: [userId], references: [id])
  items        CommandItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([truckId])
  @@index([userId])
  @@index([status])
}

model CommandItem {
  id        Int     @id @default(autoincrement())
  commandId Int
  command   Command @relation(fields: [commandId], references: [id])
  articleId Int
  article   Article @relation(fields: [articleId], references: [id])
  quantity  Int
  unitPrice Float

  @@unique([commandId, articleId])
  @@index([commandId])
  @@index([articleId])
}

model Article {
  id         Int      @id @default(autoincrement())
  reference  String   @unique
  label      String
  weight     Float
  price      Float
  stock      Int      @default(0)
  locationId Int
  location   Location @relation(fields: [locationId], references: [id])

  supplierId Int?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  items CommandItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId])
  @@index([supplierId])
}

model Location {
  id       Int          @id @default(autoincrement())
  building BuildingName
  aisle    Int
  shelf    Int
  cell     Int
  articles Article[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([building, aisle, shelf, cell])
}

model Client {
  id       Int       @id @default(autoincrement())
  name     String
  address  String
  email    String?
  phone    String?   @db.VarChar(20)
  commands Command[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Truck {
  id       Int       @id @default(autoincrement())
  imat     String    @unique
  maxLoad  Float
  commands Command[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id       Int       @id @default(autoincrement())
  name     String    @db.VarChar(100)
  email    String?   @db.VarChar(100)
  phone    String?   @db.VarChar(20)
  address  String    @db.VarChar(255)
  articles Article[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

enum UserRole {
  MANAGER
  MAGASINIER
}

enum CommandStatus {
  WAITING
  PENDING
  DELIVERED
  CANCELLED
}

enum BuildingName {
  A
  B
  C
}
